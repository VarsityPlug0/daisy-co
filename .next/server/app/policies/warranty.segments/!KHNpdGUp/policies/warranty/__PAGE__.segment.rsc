0:{"buildId":"7_nsnPZhf5FbywlGvamjW","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"max-w-3xl mx-auto px-5 sm:px-8 py-20","children":[["$","div",null,{"className":"mb-10","children":[["$","p",null,{"className":"section-label mb-3","children":"Legal"}],["$","h1",null,{"className":"text-4xl font-extrabold text-white mb-2","children":[["$","span",null,{"className":"gold-text","children":"Warranty"}]," Policy"]}],["$","p",null,{"className":"text-gray-500 text-sm","children":"Last updated: August 2025"}]]}],["$","div",null,{"className":"space-y-8 text-gray-400 text-sm leading-relaxed","children":[["$","div","1. Warranty Coverage",{"children":[["$","h2",null,{"style":{"fontFamily":"var(--font-outfit)","fontWeight":700,"fontSize":16,"color":"#fff","marginBottom":8},"children":"1. Warranty Coverage"}],["$","p",null,{"children":"All products sold by Daisy Gadgets Co. come with the standard manufacturer warranty. Most products carry a 12–24 month warranty. Specific warranty periods are listed on each product page."}]]}],["$","div","2. What Is Covered",{"children":[["$","h2",null,{"style":{"fontFamily":"var(--font-outfit)","fontWeight":700,"fontSize":16,"color":"#fff","marginBottom":8},"children":"2. What Is Covered"}],["$","p",null,{"children":"Warranty covers manufacturing defects, component failures under normal use, and factory faults. We sell 100% authentic products from authorised suppliers, ensuring valid manufacturer warranties."}]]}],["$","div","3. What Is Not Covered",{"children":[["$","h2",null,{"style":{"fontFamily":"var(--font-outfit)","fontWeight":700,"fontSize":16,"color":"#fff","marginBottom":8},"children":"3. What Is Not Covered"}],["$","p",null,{"children":"Warranty does not cover: physical damage caused by the customer; water or liquid damage; damage from misuse, accidents, or unauthorised repairs; cosmetic damage (scratches, dents); and normal wear and tear."}]]}],["$","div","4. How to Claim Warranty",{"children":[["$","h2",null,{"style":{"fontFamily":"var(--font-outfit)","fontWeight":700,"fontSize":16,"color":"#fff","marginBottom":8},"children":"4. How to Claim Warranty"}],["$","p",null,{"children":"Step 1: Contact us via email with your order reference and a description of the issue. Step 2: Provide photos or a video demonstrating the fault. Step 3: We will assess the claim and advise on the next steps — this may include repair, replacement, or refund depending on the situation."}]]}],["$","div","5. Warranty Processing Time",{"children":[["$","h2",null,{"style":{"fontFamily":"var(--font-outfit)","fontWeight":700,"fontSize":16,"color":"#fff","marginBottom":8},"children":"5. Warranty Processing Time"}],["$","p",null,{"children":"Warranty assessments typically take 3–7 business days. Repairs or replacements may take additional time depending on the manufacturer and product availability."}]]}],["$","div","6. Replacement vs Repair",{"children":[["$","h2",null,{"style":{"fontFamily":"var(--font-outfit)","fontWeight":700,"fontSize":16,"color":"#fff","marginBottom":8},"children":"6. Replacement vs Repair"}],["$","p",null,{"children":"Where possible, we offer a direct replacement for faulty items. If a replacement is not available, we will arrange a repair or issue a store credit or refund."}]]}],["$","div","7. International Warranty",{"children":[["$","h2",null,{"style":{"fontFamily":"var(--font-outfit)","fontWeight":700,"fontSize":16,"color":"#fff","marginBottom":8},"children":"7. International Warranty"}],["$","p",null,{"children":"For customers outside South Africa, warranty is handled through us directly. You do not need to send items back to the manufacturer. Contact us and we will guide the process."}]]}],["$","div","8. Contact",{"children":[["$","h2",null,{"style":{"fontFamily":"var(--font-outfit)","fontWeight":700,"fontSize":16,"color":"#fff","marginBottom":8},"children":"8. Contact"}],["$","p",null,{"children":"Warranty claims: daisygadgetsco@gmail.com"}]]}]]}],["$","div",null,{"className":